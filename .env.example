# 复制为 .env 后填写；也可以直接写在 config.toml 的 [llm] api_key 里。
# 环境变量优先级高于配置文件。

# 大模型（默认 DeepSeek，任何 OpenAI 兼容服务都行）
ROBOT_API_KEY=sk-xxxxxxxxxxxxxxxx
# ROBOT_BASE_URL=https://api.deepseek.com/v1
# ROBOT_MODEL=deepseek-chat

# OneBot 连接令牌（与 NapCat 里配置的 token 保持一致，留空表示不校验）
# ROBOT_ONEBOT_TOKEN=your-token

# 日志级别
# ROBOT_LOG_LEVEL=INFO
